# 환경변수 견본. `npm run setup`이 이 파일을 복사해서 .env 를 만든다 (.env는 커밋 금지)
# 값을 비워두면 기본값을 쓴다. 지금은 아무것도 안 바꿔도 동작함

# ---------- Backend ----------
# DB 파일(SQLite)과 로그인 서명 키를 두는 폴더 (backend/ 기준 상대경로). 비우면 backend/data
# 팀 공용 서버(server 파일, npm run serve)는 자동으로 server-data/ 를 쓰므로 여기서 바꿀 필요 없음
DATA_DIR=
# 비우면 SQLite 파일(DATA_DIR/app.db) 사용 — 설치할 것 없음
# PostgreSQL로 바꿀 때: postgresql+psycopg://user:password@localhost:5432/dbname (pip install "psycopg[binary]" 필요)
# 주의: 여기에 직접 넣으면 개발용과 공용 서버가 같은 DB를 씀
DATABASE_URL=
# 비우면 테스트마다 임시 SQLite 파일 사용
TEST_DATABASE_URL=
# 로그인 토큰 서명 키. 비우면 DATA_DIR/.jwt-secret 에 자동 생성 (PC마다 다름, 커밋 안 됨)
# 주의: 여기에 직접 넣으면 개발용과 공용 서버가 같은 키를 씀 → 비워두기 권장
JWT_SECRET=
# 로그인 유지 시간(분). 비우면 7일
JWT_EXPIRE_MINUTES=
# OCR 엔진: mock(고정 샘플) | paddle(3단계에서 구현)
OCR_ENGINE=mock
# 업로드 이미지 저장 폴더 (backend/ 기준 상대경로). 공용 서버는 자동으로 server-data/storage
STORAGE_DIR=storage
# 프론트를 다른 출처에서 띄울 때만 필요 (JSON 배열 형식)
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ---------- Frontend (Vite) ----------
# 비우면 같은 출처(/api)로 요청 → Vite 개발 서버가 백엔드로 넘겨줌. 폰 테스트도 이 방식 그대로 동작
VITE_API_BASE_URL=
# Vite가 /api 요청을 넘길 백엔드 주소 (브라우저 코드에는 노출되지 않음)
API_PROXY_TARGET=http://127.0.0.1:8000

# ---------- 팀 공용 서버 (server 파일, npm run serve) ----------
# 같은 와이파이의 다른 PC·폰이 접속할 포트. 비우면 8080
SERVER_PORT=
# 다른 와이파이·LTE에서도 접속할 https 주소(Cloudflare 무료 터널). off 로 쓰면 같은 와이파이 전용
SERVER_TUNNEL=
# 직접 설치한 cloudflared를 쓰려면 실행 파일 경로 (비우면 처음 한 번 자동으로 내려받음)
CLOUDFLARED_PATH=
