# 비밀값 — .env.example만 커밋
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Vite
node_modules/
dist/
dev-dist/
*.local
*.tsbuildinfo

# SQLite DB 파일 (각자 PC에서 npm run setup 때 생성)
backend/data/*
!backend/data/.gitkeep
*.db
*.db-wal
*.db-shm

# 업로드된 영수증 이미지 (로컬 파일시스템 저장소)
backend/storage/*
!backend/storage/.gitkeep

# 공용 서버 모드의 운영 데이터 (DB·영수증 사진·로그인 키·백업) — 절대 커밋 금지
server-data/
# 공용 서버가 처음 한 번 내려받는 도구 (cloudflared 등)
.tools/

# 데이터셋 원본 이미지 — 카드번호·승인번호 등이 찍혀 있으므로 레포 대신 팀 드라이브로 공유
dataset/images/*
!dataset/images/.gitkeep

# OS / 에디터
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
